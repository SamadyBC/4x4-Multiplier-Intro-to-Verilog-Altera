#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x586ee5a3c4a0 .scope module, "mux2_1_tb" "mux2_1_tb" 2 3;
 .timescale -9 -9;
v0x586ee5a52810_0 .var "a", 3 0;
v0x586ee5a528f0_0 .var "b", 3 0;
v0x586ee5a529c0_0 .var "sel", 0 0;
v0x586ee5a52ac0_0 .net "y", 3 0, v0x586ee5a52680_0;  1 drivers
S_0x586ee5a3c630 .scope module, "dut01" "mux2_1" 2 9, 3 3 0, S_0x586ee5a3c4a0;
 .timescale -9 -9;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /OUTPUT 4 "y";
    .port_info 3 /INPUT 1 "sel";
v0x586ee5a2cb10_0 .net "a", 3 0, v0x586ee5a52810_0;  1 drivers
v0x586ee5a524d0_0 .net "b", 3 0, v0x586ee5a528f0_0;  1 drivers
v0x586ee5a525b0_0 .net "sel", 0 0, v0x586ee5a529c0_0;  1 drivers
v0x586ee5a52680_0 .var "y", 3 0;
E_0x586ee5a3d260 .event anyedge, v0x586ee5a525b0_0, v0x586ee5a2cb10_0, v0x586ee5a524d0_0;
    .scope S_0x586ee5a3c630;
T_0 ;
    %wait E_0x586ee5a3d260;
    %load/vec4 v0x586ee5a525b0_0;
    %dup/vec4;
    %pushi/vec4 0, 0, 1;
    %cmp/u;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 1;
    %cmp/u;
    %jmp/1 T_0.1, 6;
    %load/vec4 v0x586ee5a2cb10_0;
    %store/vec4 v0x586ee5a52680_0, 0, 4;
    %jmp T_0.3;
T_0.0 ;
    %load/vec4 v0x586ee5a2cb10_0;
    %store/vec4 v0x586ee5a52680_0, 0, 4;
    %jmp T_0.3;
T_0.1 ;
    %load/vec4 v0x586ee5a524d0_0;
    %store/vec4 v0x586ee5a52680_0, 0, 4;
    %jmp T_0.3;
T_0.3 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x586ee5a3c4a0;
T_1 ;
    %vpi_call 2 17 "$dumpfile", "mux2_1.vcd" {0 0 0};
    %vpi_call 2 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x586ee5a3c4a0 {0 0 0};
    %vpi_call 2 20 "$display", "========================================" {0 0 0};
    %vpi_call 2 21 "$display", "        Multiplier 4x4 TESTBENCH" {0 0 0};
    %vpi_call 2 22 "$display", "========================================" {0 0 0};
    %vpi_call 2 23 "$monitor", "Time (ns): %0t | a=%0h - b=%0h - sel= %0h y=%0h", $time, v0x586ee5a52810_0, v0x586ee5a528f0_0, v0x586ee5a529c0_0, v0x586ee5a52ac0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x586ee5a529c0_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x586ee5a52810_0, 0, 4;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x586ee5a528f0_0, 0, 4;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x586ee5a529c0_0, 0, 1;
    %delay 30, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x586ee5a52810_0, 0, 4;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x586ee5a528f0_0, 0, 4;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x586ee5a529c0_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x586ee5a529c0_0, 0, 1;
    %delay 30, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x586ee5a52810_0, 0, 4;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x586ee5a528f0_0, 0, 4;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x586ee5a529c0_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x586ee5a529c0_0, 0, 1;
    %delay 30, 0;
    %end;
    .thread T_1;
